NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/invoice-risk
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
STORAGE_DIR=./uploads
MAX_UPLOAD_MB=1
OCR_PROVIDER=ocr-space
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
GST_VERIFICATION_PROVIDER=none
GSTINAPI_API_KEY=
GSTINAPI_REQUEST_TIMEOUT_MS=10000
TALLY_PROVIDER=mock
TALLY_XML_URL=http://127.0.0.1:9000
TALLY_COMPANY_NAME=
TALLY_REQUEST_TIMEOUT_MS=10000
TALLY_MOCK_RECORDS=[]
